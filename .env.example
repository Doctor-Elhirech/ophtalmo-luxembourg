# The stable public origin only: no path or generated preview deployment URL.
# Change this to the purchased domain when that domain is attached to Vercel.
PUBLIC_SITE_ORIGIN=https://ophtalmo-luxembourg.vercel.app

# Production indexing is enabled by default. Set false only to exclude a demo.
# Development and Vercel preview environments stay noindex independently.
PUBLIC_SITE_INDEXABLE=true

# Optional public verification tokens supplied by the respective webmaster accounts.
# Paste only the content value, not the complete HTML meta tag.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Leave blank until the final-domain GA4 web stream, consent flow and privacy
# notice have been checked. A blank value sends no Analytics data.
PUBLIC_GA_MEASUREMENT_ID=
# Set to true only after the French, English and Luxembourgish privacy notices
# describe the active Google Analytics setup and withdrawal option.
PUBLIC_GA_PRIVACY_NOTICE_READY=false
