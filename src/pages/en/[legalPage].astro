---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegalPage from '../../components/LegalPage.astro';
import { localePath } from '../../content/translations';

export function getStaticPaths() {
  return (['legal', 'privacy'] as const).map((page) => ({
    params: { legalPage: localePath('en', page).split('/').filter(Boolean).at(-1) },
    props: { page },
  }));
}
const { page } = Astro.props;
---
<BaseLayout locale="en" page={page}>
  <LegalPage locale="en" page={page} />
</BaseLayout>
