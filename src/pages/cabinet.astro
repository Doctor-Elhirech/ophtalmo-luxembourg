---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PracticeDetail from '../components/PracticeDetail.astro';
import { translations } from '../content/translations';
const t = translations.fr;
---
<BaseLayout locale="fr" page="practice">
  <PageHero label={t.practicePage.label} title={t.practicePage.title} emphasis={t.practicePage.emphasis} intro={t.practicePage.intro} />
  <PracticeDetail t={t} locale="fr" />
</BaseLayout>
