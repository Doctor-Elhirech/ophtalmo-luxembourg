---
import type { Translation } from '../content/translations';
import VisitFaq from './VisitFaq.astro';
import BookingOptions from './BookingOptions.astro';
import Arrow from './Arrow.astro';
import OpeningHours from './OpeningHours.astro';
import WhatsAppForm from './WhatsAppForm.astro';
interface Props { t: Translation }
const { t } = Astro.props;
---

<section id="appointment" class="contact-hero container" aria-labelledby="contact-page-title">
  <div class="contact-hero-copy">
    <p class="eyebrow">{t.contactPage.label}</p>
    <h1 id="contact-page-title">{t.contactPage.title}<br /><em>{t.contactPage.emphasis}</em></h1>
    <p class="contact-hero-intro">{t.contactPage.intro}</p>
  </div>

  <div class="contact-booking-panel" aria-labelledby="contact-booking-title">
    <p class="eyebrow">{t.contactPage.bookingTitle}</p>
    <h2 id="contact-booking-title">{t.contactPage.bookingPanelTitle}</h2>
    <p class="contact-booking-description">{t.contactPage.bookingText}</p>
    <BookingOptions t={t} />
    <div class="contact-booking-support">
      <span>{t.contactPage.phoneTitle}</span>
      <a href={t.phoneHref}>{t.phone}<Arrow /></a>
    </div>
  </div>
</section>

<WhatsAppForm t={t} />

<section id="contact" class="contact-essentials container" aria-labelledby="contact-essentials-title">
  <div class="contact-essentials-heading">
    <p class="eyebrow">{t.contactSection.label}</p>
    <h2 id="contact-essentials-title">{t.contactPage.detailsTitle}</h2>
  </div>

  <div class="contact-info-grid">
    <div class="contact-info-card">
      <h3>{t.contactSection.addressLabel}</h3>
      <address>{t.address.street}<br />{t.address.postalCity}, {t.contactSection.country}</address>
      <a class="text-link" href={t.directionsUrl} target="_blank" rel="noopener noreferrer" aria-label={`${t.contactPage.directionsLabel} (${t.accessibility.newTab})`}>
        {t.contactPage.directionsLabel}<Arrow diagonal />
      </a>
    </div>

    <div class="contact-info-card">
      <h3>{t.contactSection.contactLabel}</h3>
      <a class="contact-info-phone" href={t.phoneHref}>{t.phone}</a>
      <a class="contact-info-email" href={`mailto:${t.email}`}>{t.email}</a>
    </div>

    <div class="contact-info-card">
      <h3>{t.contactSection.hoursLabel}</h3>
      <OpeningHours t={t} />
      <p class="contact-hours-note">{t.contactPage.hoursText}</p>
    </div>
  </div>

  <div class="contact-map">
    <iframe title={t.contactSection.mapTitle} src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d645.1!2d6.019671!3d49.632807!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47954d74b6ca8aeb%3A0x85543fbd0ff4d224!2sOphtalmo%20Luxembourg!5e0!3m2!1sfr!2slu!4v1" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
  </div>
</section>

<VisitFaq t={t} />
