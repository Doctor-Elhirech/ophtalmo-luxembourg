---
import type { Locale, Translation } from '../content/translations';
import { localePath } from '../content/translations';
import PracticeGallery from './PracticeGallery.astro';
import BookingOptions from './BookingOptions.astro';
import Journey from './Journey.astro';
import Arrow from './Arrow.astro';
import imageMetadata from '../config/image-metadata.json';
interface Props { t: Translation; locale: Locale }
const { t, locale } = Astro.props;
const entrancePhoto = imageMetadata['entrance-detail'];
---

<section class="practice-arrival container" aria-labelledby="practice-arrival-title">
  <figure class="practice-arrival-media">
    <a
      class="practice-arrival-photo gallery-open"
      href="/images/entrance-detail.webp"
      data-photo-alt={t.practicePage.entranceDetailAlt}
      data-photo-caption={t.practicePage.entranceDetailCaption}
      aria-label={`${t.accessibility.openPhoto} — ${t.practicePage.entrancePhotoLabel}: ${t.practicePage.entranceDetailCaption}`}
    >
      <div class="photo" style={`--photo-ratio: ${entrancePhoto.width} / ${entrancePhoto.height}`}>
        <img
          src="/images/entrance-detail.webp"
          width={entrancePhoto.width}
          height={entrancePhoto.height}
          alt={t.practicePage.entranceDetailAlt}
          loading="eager"
          decoding="async"
        />
        <span class="photo-fallback" hidden>{t.accessibility.imageUnavailable}</span>
      </div>
      <span class="practice-arrival-photo-label">{t.practicePage.entrancePhotoLabel}</span>
    </a>
    <figcaption>{t.practicePage.entrancePhotoNote}</figcaption>
  </figure>
  <div class="practice-arrival-copy">
    <p class="eyebrow">{t.practicePage.arrivalTitle}</p>
    <h2 id="practice-arrival-title">{t.practicePage.arrivalHeading}</h2>
    <address class="practice-arrival-address">
      {t.address.street}<br />{t.address.postalCity}, {t.contactSection.country}
    </address>
    <div class="practice-arrival-links">
      <a class="text-link" href={t.directionsUrl} target="_blank" rel="noopener noreferrer" aria-label={`${t.action.directions} (${t.accessibility.newTab})`}>
        {t.action.directions}<Arrow diagonal />
      </a>
      <a class="text-link" href={localePath(locale, 'contact')}>
        {t.practicePage.hoursLink}<Arrow />
      </a>
    </div>
    <div class="practice-arrival-notes">
      {t.practicePage.arrivalNotes.map((note) => (
        <div>
          <h3>{note.title}</h3>
          <p>{note.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
<PracticeGallery t={t} locale={locale} />
<Journey t={t} />
<section class="detail-booking-band">
  <div class="container detail-booking-layout">
    <div>
      <p class="eyebrow">{t.practicePage.bookingLabel}</p>
      <h2>{t.practicePage.bookingTitle}</h2>
      <p>{t.practicePage.bookingIntro}</p>
    </div>
    <BookingOptions t={t} />
  </div>
</section>
