---
interface Props {
  label: string;
  title: string;
  emphasis: string;
  intro: string;
  class?: string;
}
const { label, title, emphasis, intro, class: className } = Astro.props;
---

<section class:list={['page-hero container', className]} aria-labelledby="page-title">
  <p class="eyebrow">{label}</p>
  <h1 id="page-title">{title}<br /><em>{emphasis}</em></h1>
  <p class="page-hero-intro">{intro}</p>
</section>
