---
import type { Locale } from '../content/translations';

interface Props {
  locale: Locale;
  measurementId: string;
  privacyHref: string;
}

const { locale, measurementId, privacyHref } = Astro.props;
const copy = {
  fr: {
    label: 'Choix de mesure d’audience',
    title: 'Mesure d’audience facultative',
    description: 'Autorisez Google Analytics à mesurer les visites du site. Vous pourrez modifier votre choix dans « Choix des cookies ».',
    accept: 'Accepter',
    reject: 'Refuser',
    privacy: 'En savoir plus',
  },
  en: {
    label: 'Audience measurement choice',
    title: 'Optional analytics',
    description: 'Allow Google Analytics to measure visits to this website. You can change your choice later in Cookie settings.',
    accept: 'Accept',
    reject: 'Reject',
    privacy: 'Learn more',
  },
  lb: {
    label: 'Auswiel fir d’Visiteursmoossung',
    title: 'Fräiwëlleg Visiteursmoossung',
    description: 'Erlaabt Google Analytics, d’Visitten op dëser Websäit ze moossen. Dir kënnt Är Wiel spéider an de Cookie-Astellunge änneren.',
    accept: 'Akzeptéieren',
    reject: 'Ofleenen',
    privacy: 'Méi gewuer ginn',
  },
}[locale];
---

<aside class="analytics-consent" data-analytics-consent data-measurement-id={measurementId} aria-label={copy.label} hidden>
  <div class="analytics-consent-copy">
    <p class="analytics-consent-title">{copy.title}</p>
    <p>{copy.description} <a href={privacyHref}>{copy.privacy}</a></p>
  </div>
  <div class="analytics-consent-actions">
    <button type="button" data-analytics-reject>{copy.reject}</button>
    <button type="button" data-analytics-accept>{copy.accept}</button>
  </div>
</aside>
