---
import type { Translation } from '../content/translations';
import Photo from './Photo.astro';
import BookingLink from './BookingLink.astro';
import Arrow from './Arrow.astro';
interface Props {
  t: Translation;
}
const { t } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-top container">
    <div class="hero-heading">
      <p class="eyebrow hero-eyebrow">{t.hero.eyebrow}</p>
      <h1 id="hero-title">
        {t.hero.line1}
        <br />
        <em>{t.hero.line2}</em>
      </h1>
    </div>
    <div class="hero-intro">
      <p>{t.hero.intro}</p>
      <p class="hero-provider">{t.hero.provider}</p>
      <BookingLink t={t} />
      <a class="hero-secondary-booking" href={t.doctipro.bookingUrl} target="_blank" rel="noopener noreferrer">
        {t.appointment.alternativeBooking} <Arrow diagonal />
      </a>
      <span class="trust-cue">{t.hero.trustCue}</span>
    </div>
  </div>
  <figure class="hero-figure container">
    <Photo slot="streetReference" t={t} eager sizes="(max-width: 767px) 100vw, 94vw" />
    <figcaption>
      <span>{t.hero.caption}</span>
      <span>{t.hero.coordinate}</span>
      <a href="#practice">
        {t.action.discover}
        <Arrow />
      </a>
    </figcaption>
  </figure>
</section>
