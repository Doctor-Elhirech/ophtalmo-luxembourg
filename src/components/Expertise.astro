---
import type { Locale, Translation } from '../content/translations';
import { localePath } from '../content/translations';
import BookingLink from './BookingLink.astro';
interface Props {
  t: Translation;
  locale: Locale;
  compact?: boolean;
}
const { t, locale, compact = false } = Astro.props;
const items = compact ? t.expertiseSection.items.slice(0, 4) : t.expertiseSection.items;
---

<section id="expertise" class="expertise-section section-space" aria-labelledby="expertise-title">
  <div class="container expertise-layout">
    <div class="expertise-heading">
      <p class="eyebrow">{t.expertiseSection.label}</p>
      <h2 id="expertise-title">
        {t.expertiseSection.title}
        <br />
        <em>{t.expertiseSection.emphasis}</em>
      </h2>
      <p>{t.expertiseSection.intro}</p>
      <BookingLink t={t} variant="text" />
    </div>
    <ol class="expertise-list">
      {items.map((item, index) => (
        <li>
          <span class="item-number" aria-hidden="true">
            {t.numbers[index]}
          </span>
          <div>
            <h3>{item.name}</h3>
            <p>{item.detail}</p>
          </div>
        </li>
      ))}
      {compact && (
        <li class="expertise-more-item">
          <a class="text-link" href={localePath(locale, 'expertise')}>
            {t.action.moreExpertise}
            <span aria-hidden="true">↗</span>
          </a>
        </li>
      )}
    </ol>
  </div>
</section>
