---
import type { Translation } from '../content/translations';
import BookingLink from './BookingLink.astro';
import Arrow from './Arrow.astro';
import VisitFaq from './VisitFaq.astro';
import OpeningHours from './OpeningHours.astro';
interface Props {
  t: Translation;
}
const { t } = Astro.props;
---

<section
  id="appointment"
  class="appointment-section section-space"
  aria-labelledby="appointment-title"
>
  <div class="container appointment-layout">
    <div>
      <p class="eyebrow">{t.appointment.label}</p>
      <h2 id="appointment-title">
        {t.appointment.title}
        <br />
        <em>{t.appointment.emphasis}</em>
      </h2>
    </div>
    <div class="appointment-actions">
      <p>{t.appointment.text}</p>
      <BookingLink t={t} label={t.action.availability} variant="light" />
      <span class="booking-note">{t.appointment.bookingNote}</span>
      <a
        class="text-link alternative-booking"
        href={t.doctipro.bookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${t.appointment.alternativeBooking} (${t.accessibility.newTab})`}
      >
        <span>{t.appointment.alternativeBooking}</span>
        <Arrow diagonal />
      </a>
      <div class="appointment-phone">
        <span>{t.appointment.phoneLabel}</span>
        <a href={t.phoneHref}>
          {t.phone}
          <Arrow />
        </a>
      </div>
    </div>
  </div>
</section>
<VisitFaq t={t} />
<section
  id="contact"
  class="contact-section container section-space"
  aria-labelledby="contact-title"
>
  <div class="contact-content">
    <p class="eyebrow">{t.contactSection.label}</p>
    <h2 id="contact-title">
      {t.contactSection.title}
      <br />
      <em>{t.contactSection.emphasis}</em>
    </h2>
    <div class="contact-details">
      <div>
        <h3 class="eyebrow">{t.contactSection.addressLabel}</h3>
        <address>
          {t.address.street}
          <br />
          {t.address.postalCity}
          <br />
          {t.contactSection.country}
        </address>
      </div>
      <div>
        <h3 class="eyebrow">{t.contactSection.contactLabel}</h3>
        <a class="contact-phone" href={t.phoneHref}>
          {t.phone}
        </a>
        <div class="email-wrapper">
          <a class="contact-email" href={`mailto:${t.email}`}>
            {t.email}
          </a>
          <button class="copy-btn" data-copy={t.email} aria-label={t.accessibility.copyEmail} title={t.accessibility.copyEmail}>
            <svg width="1.1em" height="1.1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          </button>
        </div>
      </div>
      <div class="opening-hours">
        <h3 class="eyebrow">{t.contactSection.hoursLabel}</h3>
        <OpeningHours t={t} compact />
      </div>
    </div>
    <a
      class="directions-link"
      href={t.directionsUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`${t.action.directions} (${t.accessibility.newTab})`}
    >
      <span>{t.action.directions}</span>
      <Arrow diagonal />
    </a>
  </div>
  <div class="contact-map">
    <iframe
      title={t.contactSection.mapTitle}
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d645.1!2d6.019671!3d49.632807!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47954d74b6ca8aeb%3A0x85543fbd0ff4d224!2sOphtalmo%20Luxembourg!5e0!3m2!1sfr!2slu!4v1"
      width="600"
      height="450"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
  </div>
</section>

