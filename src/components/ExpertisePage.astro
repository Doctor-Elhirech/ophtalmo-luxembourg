---
import type { Locale, Translation } from '../content/translations';
import { localePath } from '../content/translations';
import { careGuides, careGuidePath, type CareGuideId } from '../content/care-guides';
import BookingOptions from './BookingOptions.astro';
import Arrow from './Arrow.astro';
interface Props { t: Translation; locale: Locale }
const { t, locale } = Astro.props;
const guideForCard: Partial<Record<number, CareGuideId>> = {
  0: 'eye-examination',
  2: 'glasses-contact-lenses',
  3: 'cataract',
};
---

<section class="detail-page container">
  <div class="detail-intro-row">
    <p class="section-description detail-intro-wide">{t.expertisePage.publishedNote}</p>
    <a class="text-link" href={localePath(locale, 'contact')}>
      {t.expertisePage.appointmentLabel}<Arrow />
    </a>
  </div>
  <div class="care-detail-grid">
    {t.expertisePage.items.map((item, index) => (
      <details class="care-card" name="care-areas">
        <summary class="care-card-summary">
          <span class="care-card-heading">
            <span class="item-number" aria-hidden="true">{t.numbers[index]}</span>
            <span class="care-card-title">{item.title}</span>
          </span>
          <span class="care-card-preview" data-nosnippet={index === 1 ? true : undefined}>{item.text}</span>
          <span class="care-card-action" aria-hidden="true">
            <span class="care-card-open-label">{t.expertisePage.expandLabel}</span>
            <span class="care-card-close-label">{t.expertisePage.collapseLabel}</span>
            <span class="care-card-toggle">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                <path d="M5 12h14M12 5v14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              </svg>
            </span>
          </span>
        </summary>
        <div class="care-card-body">
          {item.expanded.map((detail) => (
            <div class="care-card-detail">
              <h3>{detail.label}</h3>
              <p>{detail.text}</p>
            </div>
          ))}
          {guideForCard[index] && (
            <a class="text-link care-guide-link" href={careGuidePath(locale, guideForCard[index]!)}>
              {careGuides[locale][guideForCard[index]!].name}<Arrow />
            </a>
          )}
        </div>
      </details>
    ))}
  </div>
</section>
<section class="detail-note-section container">
  <div class="placeholder-panel" data-nosnippet>
    <p class="eyebrow">{t.expertisePage.confirmationTitle}</p>
    <p>{t.expertisePage.confirmationText}</p>
  </div>
</section>

<style>
  .care-guide-link { grid-column: 1 / -1; justify-self: start; max-width: 100%; }
  .care-guide-link :global(.arrow) { flex-shrink: 0; }
</style>
<section class="detail-booking-band">
  <div class="container detail-booking-layout">
    <div>
      <p class="eyebrow">{t.appointment.label}</p>
      <h2>{t.expertisePage.visitTitle}</h2>
      <p>{t.expertisePage.visitIntro}</p>
    </div>
    <BookingOptions t={t} />
  </div>
</section>
