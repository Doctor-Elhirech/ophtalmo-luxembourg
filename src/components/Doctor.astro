---
import type { Locale, Translation } from '../content/translations';
import { localePath } from '../content/translations';
import Photo from './Photo.astro';
import Arrow from './Arrow.astro';
interface Props {
  t: Translation;
  locale: Locale;
  compact?: boolean;
}
const { t, locale, compact = false } = Astro.props;
const qualifications = compact ? t.doctorSection.qualifications.slice(0, 2) : t.doctorSection.qualifications;
---

<section class="introduction container" aria-labelledby="intro-title">
  <p class="eyebrow">{t.introduction.label}</p>
  <h2 id="intro-title">
    {t.introduction.title}
    <br />
    <em>{t.introduction.emphasis}</em>
  </h2>
  <p class="intro-description">{t.introduction.text}</p>
</section>
<section id="doctor" class="doctor-section container section-space" aria-labelledby="doctor-title">
  <figure class="doctor-photo">
    <Photo slot="consultation" t={t} />
    <figcaption>{t.doctorSection.caption}</figcaption>
  </figure>
  <div class="doctor-copy">
    <p class="eyebrow">{t.doctorSection.label}</p>
    <h2 id="doctor-title">
      {t.doctorSection.nameFirst}
      <br />
      {t.doctorSection.nameLast}
    </h2>
    <p class="doctor-role">{t.doctorSection.role}</p>
    <ul class="qualifications">
      {qualifications.map((qualification) => (
        <li>{qualification}</li>
      ))}
    </ul>
    <div class="doctor-profiles">
      <h3 class="eyebrow" id="profiles-title">
        {t.doctorSection.profilesLabel}
      </h3>
      <ul class="profile-links" aria-labelledby="profiles-title">
        <li>
          <a
            class="text-link"
            href={t.profileUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${t.doctorSection.doctenaProfile} (${t.accessibility.newTab})`}
          >
            Doctena
            <Arrow diagonal />
          </a>
        </li>
        <li>
          <a
            class="text-link"
            href={t.doctipro.profileUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${t.doctorSection.doctiproProfile} (${t.accessibility.newTab})`}
          >
            Doctipro
            <Arrow diagonal />
          </a>
        </li>
      </ul>
    </div>
    {compact && (
      <a class="text-link section-more-link" href={localePath(locale, 'doctor')}>
        {t.action.moreDoctor}
        <Arrow />
      </a>
    )}
  </div>
</section>
