---
import type { Translation } from '../content/translations';
import { practice } from '../config/practice';
import Arrow from './Arrow.astro';
interface Props { t: Translation }
const { t } = Astro.props;
const copy = t.whatsappForm;
---

<section id="whatsapp-message" class="whatsapp-form-section container" aria-labelledby="whatsapp-form-title">
  <div class="whatsapp-intro">
    <div class="whatsapp-symbol" aria-hidden="true">
      <svg viewBox="0 0 32 32" fill="none" width="28" height="28"><path d="M16 3.5a12.4 12.4 0 0 0-10.7 18.7L3.7 28l6-1.6A12.5 12.5 0 1 0 16 3.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M11 10.6c-.8.1-1.7 1.8-1.5 2.9.4 3.2 4.7 7.4 7.8 8.1 1.2.3 3.1-.8 3.3-1.7l-3-1.5-1.3 1c-1.9-.7-3.3-2.1-4-4l1-1.3-1.5-3.1-.8-.4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
    </div>
    <p class="eyebrow">{copy.label}</p>
    <h2 id="whatsapp-form-title">{copy.title}</h2>
    <p class="whatsapp-intro-text">{copy.intro}</p>
    <span class="whatsapp-accent" aria-hidden="true"></span>
  </div>

  <form class="whatsapp-form" data-whatsapp-form data-phone={practice.whatsappNumber}>
    <div class="whatsapp-fields-row">
      <div class="whatsapp-field">
        <label for="whatsapp-name">{copy.name}</label>
        <input id="whatsapp-name" name="name" type="text" autocomplete="name" maxlength="100" required />
      </div>
      <div class="whatsapp-field">
        <label for="whatsapp-subject">{copy.subject}</label>
        <select id="whatsapp-subject" name="subject" required>
          <option value="" disabled selected>{copy.subjectPlaceholder}</option>
          {copy.subjects.map((subject) => <option value={subject}>{subject}</option>)}
        </select>
      </div>
    </div>
    <div class="whatsapp-field">
      <label for="whatsapp-message-text">{copy.message}</label>
      <textarea id="whatsapp-message-text" name="message" rows="5" maxlength="1500" placeholder={copy.messagePlaceholder} required></textarea>
    </div>
    <p class="whatsapp-privacy">{copy.privacy}</p>
    <div class="whatsapp-form-bottom">
      <button type="submit" class="whatsapp-submit"><span>{copy.submit}</span><Arrow diagonal /></button>
      <p class="whatsapp-note">{copy.note}</p>
    </div>
  </form>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-whatsapp-form]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      const labels = [...form.querySelectorAll<HTMLLabelElement>('label')].map((label) => label.textContent?.trim() ?? '');
      const message = [
        `${labels[0]}: ${String(data.get('name') ?? '').trim()}`,
        `${labels[1]}: ${String(data.get('subject') ?? '').trim()}`,
        `${labels[2]}: ${String(data.get('message') ?? '').trim()}`,
      ].join('\n\n');
      window.open(`https://wa.me/${form.dataset.phone}?text=${encodeURIComponent(message)}`, '_blank', 'noopener,noreferrer');
    });
  });

  // Keep the form deep link working, then clear its fragment so a later
  // contact-page refresh can start at the top.
  const clearFormFragment = () => {
    if (location.hash !== '#whatsapp-message') return;
    window.requestAnimationFrame(() => window.requestAnimationFrame(() => {
      if (location.hash === '#whatsapp-message') {
        document.getElementById('whatsapp-message')?.scrollIntoView({ behavior: 'instant', block: 'start' });
        history.replaceState(history.state, '', location.pathname + location.search);
      }
    }));
  };
  window.addEventListener('hashchange', clearFormFragment);
  window.addEventListener('pageshow', clearFormFragment);

  const section = document.querySelector<HTMLElement>('.whatsapp-form-section');
  const accent = section?.querySelector<HTMLElement>('.whatsapp-accent');
  if (section && accent) {
    let frame = 0;
    let initialScale = Math.min(1, 82 / accent.offsetWidth);
    const updateAccent = () => {
      frame = 0;
      const bounds = section.getBoundingClientRect();
      const progress = Math.min(1, Math.max(0, (window.innerHeight * 0.85 - bounds.top) / (window.innerHeight * 0.85 + bounds.height * 0.45)));
      accent.style.setProperty('--scroll-scale', (initialScale + progress * (1 - initialScale)).toFixed(4));
    };
    const scheduleAccent = () => {
      if (!frame) frame = window.requestAnimationFrame(updateAccent);
    };
    window.addEventListener('scroll', scheduleAccent, { passive: true });
    window.addEventListener('resize', () => {
      initialScale = Math.min(1, 82 / accent.offsetWidth);
      scheduleAccent();
    });
    window.addEventListener('pageshow', scheduleAccent);
    updateAccent();
  }

  const card = section?.querySelector<HTMLElement>('.whatsapp-form');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (card && !reducedMotion.matches) {
    let completed = false;
    let timed = false;
    let frame = 0;
    let progress = 0;
    let restoredScrollHandler: (() => void) | undefined;
    const setProgress = (value: number) => {
      progress = Math.min(1, Math.max(0, value));
      card.style.setProperty('--flip-angle', `${(-66 * (1 - progress)).toFixed(2)}deg`);
      card.style.setProperty('--flip-offset', `${(28 * (1 - progress)).toFixed(2)}px`);
      card.style.setProperty('--flip-opacity', (0.48 + 0.52 * progress).toFixed(3));
    };
    const finish = () => {
      if (completed) return;
      completed = true;
      setProgress(1);
      card.classList.remove('whatsapp-scroll-flip');
      card.style.removeProperty('--flip-angle');
      card.style.removeProperty('--flip-offset');
      card.style.removeProperty('--flip-opacity');
      window.removeEventListener('scroll', schedule);
      if (restoredScrollHandler) window.removeEventListener('scroll', restoredScrollHandler);
      window.removeEventListener('resize', schedule);
      window.removeEventListener('hashchange', onHashChange);
    };
    const update = () => {
      frame = 0;
      if (completed || timed) return;
      const top = card.offsetTop - window.scrollY;
      const value = (window.innerHeight * 0.85 - top) / (window.innerHeight * 0.55);
      if (value >= 1) finish();
      else setProgress(value);
    };
    const schedule = () => {
      if (!frame) frame = window.requestAnimationFrame(update);
    };
    const startTimed = () => {
      if (completed || timed) return;
      timed = true;
      const from = progress;
      const start = performance.now();
      const animate = (now: number) => {
        if (completed) return;
        const elapsed = Math.min(1, (now - start) / 950);
        const eased = elapsed * elapsed * (3 - 2 * elapsed);
        setProgress(from + (1 - from) * eased);
        if (elapsed < 1) window.requestAnimationFrame(animate);
        else finish();
      };
      window.requestAnimationFrame(animate);
    };
    const onHashChange = () => {
      if (location.hash === '#whatsapp-message') startTimed();
    };

    card.classList.add('whatsapp-scroll-flip');
    setProgress(0);
    card.addEventListener('focusin', finish, { once: true });
    reducedMotion.addEventListener('change', (event) => {
      if (event.matches) finish();
    }, { once: true });
    window.addEventListener('hashchange', onHashChange);
    document.fonts.ready.then(() => window.requestAnimationFrame(() => {
      if (completed) return;
      const top = card.offsetTop - window.scrollY;
      const visible = top < window.innerHeight * 0.85 && top + card.offsetHeight > 0;
      const navigation = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
      if (visible && navigation?.type === 'reload') {
        let lowestScrollY = window.scrollY;
        restoredScrollHandler = () => {
          if (completed) return;
          const currentTop = card.offsetTop - window.scrollY;
          if (currentTop >= window.innerHeight * 0.85) {
            window.removeEventListener('scroll', restoredScrollHandler!);
            restoredScrollHandler = undefined;
            window.addEventListener('scroll', schedule, { passive: true });
            window.addEventListener('resize', schedule);
            update();
          } else if (window.scrollY > lowestScrollY + 2 && currentTop + card.offsetHeight > 0) {
            const value = (window.scrollY - lowestScrollY) / Math.min(320, window.innerHeight * 0.38);
            if (value >= 1) finish();
            else setProgress(value);
          }
          lowestScrollY = Math.min(lowestScrollY, window.scrollY);
        };
        window.addEventListener('scroll', restoredScrollHandler, { passive: true });
      } else if (visible) startTimed();
      else {
        window.addEventListener('scroll', schedule, { passive: true });
        window.addEventListener('resize', schedule);
        update();
      }
    }));
  }
</script>

<style>
  .whatsapp-form-section { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(28px, 5vw, 88px); align-items: center; padding-block: clamp(72px, 8vw, 130px); border-top: 1px solid var(--line); }
  .whatsapp-intro { max-width: 510px; }
  .whatsapp-symbol { display: grid; place-items: center; width: 58px; height: 58px; margin-bottom: 30px; border: 1px solid var(--forest); border-radius: 50%; color: var(--forest); background: #eaf1e9; }
  .whatsapp-intro .eyebrow { color: var(--gold-ink); }
  .whatsapp-intro h2 { margin-top: 18px; font-size: clamp(42px, 4.1vw, 68px); }
  .whatsapp-intro-text { max-width: 34ch; margin-top: 25px; color: var(--muted); font-size: clamp(16px, 1.3vw, 19px); }
  .whatsapp-accent { display: block; width: 100%; height: 4px; margin-top: 34px; background: var(--forest); transform: scaleX(var(--scroll-scale, .17)); transform-origin: left center; transition: transform 140ms linear; }
  .whatsapp-form { min-width: 0; padding: clamp(24px, 3.1vw, 46px); border: 1px solid #cbd8cd; border-top: 4px solid var(--forest); border-radius: 16px; background: #fff; box-shadow: 0 18px 55px #0a221812; }
  .whatsapp-form.whatsapp-scroll-flip { transform: perspective(1200px) rotateX(var(--flip-angle, -66deg)) translateY(var(--flip-offset, 28px)); transform-origin: center center; opacity: var(--flip-opacity, .48); backface-visibility: hidden; transition: transform 90ms linear, opacity 90ms linear; will-change: transform, opacity; }
  .whatsapp-fields-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .whatsapp-field { min-width: 0; margin-bottom: 21px; }
  .whatsapp-field label { display: block; margin-bottom: 9px; color: var(--forest); font-size: 13px; font-weight: 700; }
  .whatsapp-field :is(input, select, textarea) { display: block; width: 100%; min-height: 50px; padding: 12px 15px; border: 1px solid #bac9be; border-radius: 8px; outline: none; background: var(--paper); color: var(--ink); font: inherit; font-size: 15px; transition: border-color 180ms ease, box-shadow 180ms ease, background 180ms ease; }
  .whatsapp-field textarea { min-height: 142px; resize: vertical; }
  .whatsapp-field :is(input, select, textarea):hover { border-color: var(--forest-hover); background: #fff; }
  .whatsapp-field :is(input, select, textarea):focus-visible { border-color: var(--forest); box-shadow: 0 0 0 3px #1746342a; background: #fff; }
  .whatsapp-field :is(input, select, textarea)::placeholder { color: #69746e; }
  .whatsapp-privacy { color: var(--muted); font-size: 12px; line-height: 1.6; }
  .whatsapp-form-bottom { display: grid; gap: 13px; margin-top: 24px; }
  .whatsapp-submit { display: inline-flex; justify-content: space-between; align-items: center; gap: 20px; width: fit-content; min-height: 56px; padding: 13px 19px; border: 1px solid var(--forest); border-radius: 7px; background: var(--forest); color: #fff; font-size: 14px; font-weight: 700; transition: background 180ms ease, transform 180ms ease, box-shadow 180ms ease; }
  .whatsapp-submit:hover { background: var(--forest-hover); transform: translateY(-3px); box-shadow: 0 10px 24px #0a22182e; }
  .whatsapp-submit:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }
  .whatsapp-submit :global(.arrow) { width: 17px; height: 17px; transition: translate 180ms ease; }
  .whatsapp-submit:hover :global(.arrow) { translate: 3px -3px; }
  .whatsapp-note { color: var(--muted); font-size: 12px; line-height: 1.6; }
  @media (min-width: 1101px) { .whatsapp-note { white-space: nowrap; font-size: clamp(10px, .85vw, 12px); } }
  @media (max-width: 1100px) { .whatsapp-form-section { grid-template-columns: 1fr; } .whatsapp-intro { max-width: 650px; } }
  @media (max-width: 600px) { .whatsapp-form-section { padding-block: 70px; } .whatsapp-fields-row { grid-template-columns: 1fr; gap: 0; } .whatsapp-form { padding: 24px 20px; } .whatsapp-submit { width: 100%; } }
  @media (prefers-reduced-motion: reduce) { .whatsapp-accent, .whatsapp-submit, .whatsapp-submit :global(.arrow), .whatsapp-field :is(input, select, textarea) { transition: none; } .whatsapp-submit:hover { transform: none; } }
</style>
