---
import type { Locale, PageKey, Translation } from '../content/translations';
import { locales, localePath } from '../content/translations';
import BookingLink from './BookingLink.astro';
interface Props {
  t: Translation;
  locale: Locale;
  currentPage?: PageKey;
  alternates?: Record<Locale, string>;
}
const { t, locale, currentPage = 'home', alternates } = Astro.props;
const links = [
  ['home', t.nav.home],
  ['doctor', t.nav.doctor],
  ['expertise', t.nav.expertise],
  ['practice', t.nav.practice],
  ['contact', t.nav.contact],
] as const;
---

<header class="site-header" data-current-page={currentPage}>
  <a href={localePath(locale)} class="wordmark" aria-label={t.name}>
    <span class="brand-symbol" aria-hidden="true"></span>
    <span>
      {t.name.split(' ')[0]}
      <small>{t.name.split(' ')[1]}</small>
    </span>
  </a>
  <nav class="desktop-nav" aria-label={t.accessibility.mainNav}>
    {links.map(([id, text]) => (
      <a
        class:list={['nav-link', { 'is-active': currentPage === id }]}
        data-nav-page={id}
        href={localePath(locale, id)}
        aria-current={currentPage === id ? 'page' : undefined}
      >{text}</a>
    ))}
  </nav>
  <div class="header-actions">
    <div class="language-switch" aria-label={t.accessibility.language}>
      {locales.map((lang) => (
        <a
          href={alternates?.[lang] ?? localePath(lang, currentPage)}
          lang={lang}
          hreflang={lang}
          class="language-link"
          aria-current={lang === locale ? 'page' : undefined}
          aria-label={t.localeNames[lang]}
        >
          {t.languageShort[lang]}
        </a>
      ))}
    </div>
    <BookingLink t={t} label={t.action.availability} variant="ghost" class="header-booking" />
    <button
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label={t.accessibility.menu}
      data-open-label={t.accessibility.menu}
      data-close-label={t.accessibility.closeMenu}
    >
      <span></span>
      <span></span>
    </button>
  </div>
  <nav id="mobile-nav" class="mobile-nav" aria-label={t.accessibility.mainNav} inert>
    {links.map(([id, text], i) => (
      <a
        class:list={['nav-link', { 'is-active': currentPage === id }]}
        data-nav-page={id}
        href={localePath(locale, id)}
        aria-current={currentPage === id ? 'page' : undefined}
      >
        <span class="nav-number">{t.numbers[i]}</span>
        <span class="nav-label">{text}</span>
      </a>
    ))}
    <BookingLink t={t} />
    <a class="mobile-phone" href={t.phoneHref}>
      {t.phone}
    </a>
  </nav>
</header>
