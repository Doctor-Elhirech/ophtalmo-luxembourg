---
import { locales, localePath, type Locale, type Translation } from '../content/translations';
import Arrow from './Arrow.astro';
interface Props {
  t: Translation;
  locale: Locale;
}
const { t, locale } = Astro.props;
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div>
        <a class="footer-brand" href={localePath(locale)}>
          {t.name}
        </a>
        <p>{t.footer.descriptor}</p>
      </div>
      <nav aria-label={t.accessibility.footerNav}>
        <a href="#doctor">{t.nav.doctor}</a>
        <a href="#expertise">{t.nav.expertise}</a>
        <a href="#practice">{t.nav.practice}</a>
        <a href="#contact">{t.nav.contact}</a>
        <a href={t.bookingUrl} target="_blank" rel="noopener noreferrer">
          {t.action.book}
          <Arrow diagonal />
        </a>
      </nav>
      <div class="footer-contact">
        <a href={t.phoneHref}>{t.phone}</a>
        <a href={`mailto:${t.email}`}>{t.email}</a>
        <div class="language-switch" aria-label={t.accessibility.language}>
          {locales.map((lang) => (
            <a
              href={localePath(lang)}
              class="language-link"
              lang={lang}
              hreflang={lang}
              aria-current={lang === locale ? 'page' : undefined}
              aria-label={t.localeNames[lang]}
            >
              {t.languageShort[lang]}
            </a>
          ))}
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>
        {t.copyright} {t.year} {t.name}
      </p>
      <p>{t.footer.closing}</p>
      <a href="#top">
        {t.footer.top}
        <Arrow />
      </a>
    </div>
    <p class="demo-note">{t.footer.demo}</p>
  </div>
</footer>
<div class="mobile-contact-bar">
  <a href={t.phoneHref} class="mobile-call" aria-label={t.action.call}>
    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="m7 3 3 5-2 2a16 16 0 0 0 6 6l2-2 5 3-1 4C10 22 2 14 3 4Z"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linejoin="round"
      />
    </svg>
  </a>
  <a href={t.bookingUrl} target="_blank" rel="noopener noreferrer">
    {t.action.book}
    <Arrow diagonal />
  </a>
</div>
