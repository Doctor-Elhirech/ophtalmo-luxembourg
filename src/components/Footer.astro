---
import { locales, localePath, type Locale, type PageKey, type Translation } from '../content/translations';
import Arrow from './Arrow.astro';
interface Props {
  t: Translation;
  locale: Locale;
  currentPage?: PageKey;
  alternates?: Record<Locale, string>;
}
const { t, locale, currentPage = 'home', alternates } = Astro.props;
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div>
        <a class="footer-brand" href={localePath(locale)}>
          {t.name}
        </a>
        <p>{t.footer.descriptor}</p>
      </div>
      <nav aria-label={t.accessibility.footerNav}>
        <a href={localePath(locale, 'doctor')} aria-current={currentPage === 'doctor' ? 'page' : undefined}>{t.nav.doctor}</a>
        <a href={localePath(locale, 'expertise')} aria-current={currentPage === 'expertise' ? 'page' : undefined}>{t.nav.expertise}</a>
        <a href={localePath(locale, 'practice')} aria-current={currentPage === 'practice' ? 'page' : undefined}>{t.nav.practice}</a>
        <a href={localePath(locale, 'contact')} aria-current={currentPage === 'contact' ? 'page' : undefined}>{t.nav.contact}</a>
        <a href={t.bookingUrl} target="_blank" rel="noopener noreferrer">
          {t.action.book}
          <Arrow diagonal />
        </a>
      </nav>
      <div class="footer-contact">
        <a href={t.phoneHref}>{t.phone}</a>
        <div class="email-wrapper">
          <a href={`mailto:${t.email}`}>{t.email}</a>
          <button class="copy-btn" data-copy={t.email} aria-label={t.accessibility.copyEmail} title={t.accessibility.copyEmail}>
            <svg width="1.1em" height="1.1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          </button>
        </div>
        <div class="language-switch" aria-label={t.accessibility.language}>
          {locales.map((lang) => (
            <a
              href={alternates?.[lang] ?? localePath(lang, currentPage)}
              class="language-link"
              lang={lang}
              hreflang={lang}
              aria-current={lang === locale ? 'page' : undefined}
              aria-label={t.localeNames[lang]}
            >
              {t.languageShort[lang]}
            </a>
          ))}
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>
        {t.copyright} {t.year} {t.name}
      </p>
      <p>{t.footer.closing}</p>
      <a href="#top">
        {t.footer.top}
        <Arrow />
      </a>
    </div>
    <p class="demo-note"><span data-nosnippet>{t.footer.demo}</span></p>
  </div>
</footer>
{currentPage !== 'contact' && (
  <div class="mobile-contact-bar">
    <a href={t.phoneHref} class="mobile-call" aria-label={t.action.call}>
      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="m7 3 3 5-2 2a16 16 0 0 0 6 6l2-2 5 3-1 4C10 22 2 14 3 4Z"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linejoin="round"
        />
      </svg>
    </a>
    <a href={t.bookingUrl} target="_blank" rel="noopener noreferrer">
      {t.action.book}
      <Arrow diagonal />
    </a>
  </div>
)}
