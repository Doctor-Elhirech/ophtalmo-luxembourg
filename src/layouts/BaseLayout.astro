---
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { translations, type Locale } from '../content/translations';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteSettings } from '../config/practice';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = translations[locale];
const canonical = new URL(locale === 'fr' ? '/' : '/en/', siteSettings.origin);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="robots" content={siteSettings.indexable ? 'index, follow' : 'noindex, nofollow'} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={new URL('/', siteSettings.origin)} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', siteSettings.origin)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', siteSettings.origin)} />
    <meta name="theme-color" content="#173c34" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === 'fr' ? 'fr_LU' : 'en_GB'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={t.name} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">
      {t.accessibility.skip}
    </a>
    <Header t={t} locale={locale} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer t={t} locale={locale} />
    <script src="../scripts/interactions.ts"></script>
  </body>
</html>
