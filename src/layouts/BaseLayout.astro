---
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { translations, localePath, pageFromPath, type Locale, type PageKey } from '../content/translations';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteSettings } from '../config/practice';
interface Props {
  locale: Locale;
  page?: PageKey;
}
const { locale, page = pageFromPath(Astro.url.pathname) } = Astro.props;
const t = translations[locale];
const canonical = new URL(Astro.url.pathname, siteSettings.origin);
const pageMeta = t.pageMeta[page];
const alternateFr = new URL(localePath('fr', page), siteSettings.origin);
const alternateEn = new URL(localePath('en', page), siteSettings.origin);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageMeta.title}</title>
    <meta name="description" content={pageMeta.description} />
    <meta name="robots" content={siteSettings.indexable ? 'index, follow' : 'noindex, nofollow'} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={alternateFr} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="x-default" href={alternateFr} />
    <meta name="theme-color" content="#173c34" />
    <meta property="og:title" content={pageMeta.title} />
    <meta property="og:description" content={pageMeta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === 'fr' ? 'fr_LU' : 'en_GB'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={t.name} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">
      {t.accessibility.skip}
    </a>
    <Header t={t} locale={locale} currentPage={page} />
    <main id="main" tabindex="-1">
      {page !== 'home' && (
        <div class="back-home-row container">
          <a
            class="home-back-control"
            href={localePath(locale)}
            aria-label={t.action.home}
            data-tooltip={t.action.home}
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M19 12H5m6-6-6 6 6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      )}
      <slot />
    </main>
    <Footer t={t} locale={locale} currentPage={page} />
    <script src="../scripts/interactions.ts"></script>
  </body>
</html>
