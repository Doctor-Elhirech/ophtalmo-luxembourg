---
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/motion.css';
import '../styles/legal.css';
import analyticsStyles from '../styles/analytics.css?url';
import { translations, localePath, pageFromPath, type Locale, type PageKey } from '../content/translations';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import { siteSettings } from '../config/practice';
import { careGuides, type CareGuideId } from '../content/care-guides';
import { absoluteUrl, pageAlternates, pagePath, sharingImage, structuredData } from '../config/seo';
interface Props {
  locale: Locale;
  page?: PageKey;
  guide?: CareGuideId;
}
const { locale, page = pageFromPath(Astro.url.pathname), guide } = Astro.props;
const t = translations[locale];
const canonical = absoluteUrl(pagePath(locale, page, guide));
const pageMeta = guide ? careGuides[locale][guide] : t.pageMeta[page];
const alternates = pageAlternates(page, guide);
const alternateFr = absoluteUrl(alternates.fr);
const alternateEn = absoluteUrl(alternates.en);
const alternateLb = absoluteUrl(alternates.lb);
const graph = JSON.stringify(structuredData(locale, page, guide)).replace(/</g, '\\u003c');
const ogLocales = { fr: 'fr_LU', en: 'en_GB', lb: 'lb_LU' };
const googleVerification = import.meta.env.GOOGLE_SITE_VERIFICATION?.trim();
const bingVerification = import.meta.env.BING_SITE_VERIFICATION?.trim();
const analyticsId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim() ?? '';
if (analyticsId && !/^G-[A-Z0-9]+$/.test(analyticsId)) {
  throw new Error('PUBLIC_GA_MEASUREMENT_ID must be a valid GA4 measurement ID (G-...).');
}
if (analyticsId && import.meta.env.PUBLIC_GA_PRIVACY_NOTICE_READY !== 'true') {
  throw new Error('Update the three privacy notices before enabling GA4, then set PUBLIC_GA_PRIVACY_NOTICE_READY=true.');
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageMeta.title}</title>
    <meta name="description" content={pageMeta.description} />
    <meta name="robots" content={siteSettings.indexable ? 'index, follow, max-image-preview:large' : 'noindex, follow'} />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={alternateFr} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="lb" href={alternateLb} />
    <link rel="alternate" hreflang="x-default" href={alternateFr} />
    <meta name="theme-color" content="#0a2218" />
    <meta property="og:title" content={pageMeta.title} />
    <meta property="og:description" content={pageMeta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocales[locale]} />
    {Object.entries(ogLocales).filter(([lang]) => lang !== locale).map(([, value]) => (
      <meta property="og:locale:alternate" content={value} />
    ))}
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={t.name} />
    <meta property="og:image" content={sharingImage.url} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content={String(sharingImage.width)} />
    <meta property="og:image:height" content={String(sharingImage.height)} />
    <meta property="og:image:alt" content={t.photos.examination} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageMeta.title} />
    <meta name="twitter:description" content={pageMeta.description} />
    <meta name="twitter:image" content={sharingImage.url} />
    <meta name="twitter:image:alt" content={t.photos.examination} />
    <script type="application/ld+json" set:html={graph} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {analyticsId && <link rel="stylesheet" href={analyticsStyles} />}
  </head>
  <body id="top" data-page={page}>
    <a class="skip-link" href="#main">
      {t.accessibility.skip}
    </a>
    <Header t={t} locale={locale} currentPage={page} alternates={alternates} />
    <main id="main" tabindex="-1">
      {page !== 'home' && (
        <div class="back-home-row container">
          <a
            class="home-back-control"
            href={localePath(locale)}
            aria-label={t.action.home}
            data-tooltip={t.action.home}
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M19 12H5m6-6-6 6 6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      )}
      <slot />
    </main>
    <Footer t={t} locale={locale} currentPage={page} alternates={alternates} analyticsEnabled={Boolean(analyticsId)} />
    {analyticsId && <AnalyticsConsent locale={locale} measurementId={analyticsId} privacyHref={localePath(locale, 'privacy')} />}
    <script src="../scripts/interactions.ts"></script>
    {analyticsId && <script is:inline defer src="/analytics.js"></script>}
  </body>
</html>
